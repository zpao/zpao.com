{
  "name": "zpao.com",
  "description": "zpao.com statically generated with Next.js",
  "version": "1.0.0",
  "author": "Paul O’Shannessy <paul@oshannessy.com>",
  "private": true,
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "gray-matter": "^4.0.3",
    "html-react-parser": "^6.1.7",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-prism-plus": "^2.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "rss": "^1.2.2",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "keywords": [
    "nextjs",
    "static-site"
  ],
  "license": "MIT",
  "scripts": {
    "prepare-static": "node scripts/prepare-static.ts",
    "build": "pnpm run prepare-static && next build",
    "dev": "pnpm run prepare-static && next dev",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx,css}'",
    "deploy": "pnpm run clean && pnpm run build && pnpm run verify && pnpm run rsync",
    "clean": "rm -rf out .next .cache",
    "rsync": "rsync -avze ssh --delete out/ zpao.com:zpao.com/",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-export.ts"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/rss": "^0.0.32",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zpao/zpao.com"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
